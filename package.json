{
  "name": "limestone-qa-task",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript test framework: SauceDemo UI and JSONPlaceholder API, plus Postman collection and SQL queries",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:postman": "newman run postman/jsonplaceholder.postman_collection.json -e postman/jsonplaceholder.postman_environment.json",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.19.43",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^18.0.10",
    "newman": "^6.2.3",
    "typescript": "^5.9.3"
  }
}
