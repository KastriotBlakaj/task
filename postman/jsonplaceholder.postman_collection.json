{
  "info": {
    "name": "JSONPlaceholder - users and posts",
    "description": "Run in order (Collection Runner or `npm run test:postman`). Request 1 picks a user and stores its id; request 2 lists that user's posts; request 3 reads a post that does not exist. Shared assertions and schemas live in the collection-level scripts; each request only declares its expectations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.variables.set('expectedStatus', '');",
          "pm.variables.set('itemSchema', '');",
          "pm.variables.set('ownerUserId', '');"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const nonEmptyString = { type: 'string', minLength: 1 };",
          "const positiveInt = { type: 'integer', minimum: 1 };",
          "const schemas = {",
          "    user: {",
          "        type: 'object',",
          "        required: ['id', 'name', 'username', 'email'],",
          "        properties: {",
          "            id: positiveInt,",
          "            name: nonEmptyString,",
          "            username: nonEmptyString,",
          "            email: { type: 'string', pattern: '^[^@\\\\s]+@[^@\\\\s]+\\\\.[^@\\\\s]+$' }",
          "        }",
          "    },",
          "    post: {",
          "        type: 'object',",
          "        required: ['id', 'userId', 'title', 'body'],",
          "        properties: {",
          "            id: positiveInt,",
          "            userId: positiveInt,",
          "            title: nonEmptyString,",
          "            body: nonEmptyString",
          "        }",
          "    }",
          "};",
          "",
          "const expectedStatus = Number(pm.variables.get('expectedStatus'));",
          "const schemaName = pm.variables.get('itemSchema');",
          "const ownerUserId = pm.variables.get('ownerUserId');",
          "",
          "pm.test('request declares an expected status', function () {",
          "    pm.expect(expectedStatus, 'set expectedStatus in the request pre-request script').to.be.above(0);",
          "});",
          "",
          "pm.test('status code is ' + expectedStatus, function () {",
          "    pm.response.to.have.status(expectedStatus);",
          "});",
          "",
          "if (schemaName) {",
          "    pm.test('every item matches the \"' + schemaName + '\" schema', function () {",
          "        pm.expect(schemas, 'unknown schema name').to.have.property(schemaName);",
          "        pm.response.to.have.jsonSchema({ type: 'array', minItems: 1, items: schemas[schemaName] });",
          "    });",
          "}",
          "",
          "if (ownerUserId) {",
          "    pm.test('every post belongs to user ' + ownerUserId, function () {",
          "        const posts = pm.response.json();",
          "        pm.expect(posts, 'no posts returned, ownership check would be vacuous').to.be.an('array').that.is.not.empty;",
          "        posts.forEach(function (post) {",
          "            pm.expect(post.userId, 'post ' + post.id).to.eql(Number(ownerUserId));",
          "        });",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "userId",
      "value": "",
      "type": "string",
      "description": "Set by \"Get users\" at run time."
    },
    {
      "key": "missingPostId",
      "value": "9999",
      "type": "string",
      "description": "An id outside the 100 seeded posts."
    }
  ],
  "item": [
    {
      "name": "1. Get users",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "            pm.variables.set('expectedStatus', 200);",
              "            pm.variables.set('itemSchema', 'user');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "            if (pm.response.code === 200) {",
              "                const users = pm.response.json();",
              "                const picked = users[Math.floor(Math.random() * users.length)];",
              "                pm.collectionVariables.set('userId', picked.id);",
              "                console.log('Selected user', picked.id, picked.username);",
              "                pm.test('selected user id ' + picked.id + ' (' + picked.username + ')', function () {",
              "                    pm.expect(Number(pm.collectionVariables.get('userId'))).to.eql(picked.id);",
              "                });",
              "            }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        },
        "description": "Lists all users and stores one user id in the `userId` collection variable."
      }
    },
    {
      "name": "2. Get posts of selected user",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "            const userId = pm.collectionVariables.get('userId');",
              "            if (!userId) {",
              "                throw new Error('userId is not set. Run \"1. Get users\" first (run the whole collection in order).');",
              "            }",
              "            pm.variables.set('expectedStatus', 200);",
              "            pm.variables.set('itemSchema', 'post');",
              "            pm.variables.set('ownerUserId', userId);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/posts?userId={{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ],
          "query": [
            {
              "key": "userId",
              "value": "{{userId}}"
            }
          ]
        },
        "description": "Lists the posts of the selected user. Ownership of every post is checked at collection level."
      }
    },
    {
      "name": "3. Get missing post",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "            pm.variables.set('expectedStatus', 404);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "            pm.test('body of a missing post is an empty object', function () {",
              "                pm.expect(pm.response.json()).to.eql({});",
              "            });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/posts/{{missingPostId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "{{missingPostId}}"
          ]
        },
        "description": "Reads a post id that does not exist and expects 404."
      }
    }
  ]
}
